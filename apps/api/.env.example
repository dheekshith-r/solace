# Copy to apps/api/.env and fill in. Never commit .env.

# Supabase transaction pooler (port 6543). Used by the running API.
DATABASE_URL=

# Supabase session pooler (port 5432). Used only by `npm run db:migrate`, not needed on Render.
MIGRATION_DATABASE_URL=

# At least 32 random characters.
JWT_SECRET=

# From Google AI Studio.
GEMINI_API_KEY=

NODE_ENV=development
PORT=3000

# Proxies in front of the API whose addresses are trusted. Render: 3 (the default): a local sidecar,
# Render's load balancer, then a Cloudflare edge. Locally with no proxy, use 0.
TRUST_PROXY_HOPS=3
